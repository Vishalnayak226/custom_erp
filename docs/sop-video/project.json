  "chapters": [
    {
      "id": "purchase_requisition",
      "title": "Purchase requisition — from setup to saved request",
      "actor": "Requester and administrator",
      "start": "Start: request a needed item and know the department responsible.",
      "end": "End: a numbered Draft requisition is visible in the list; the next process is buyer review and PO.",
      "segments": [
        "department_setup",
        "requisition_create"
      ]
    },
    {
      "id": "purchase_order",
      "title": "Purchase order — from master setup to approval",
      "actor": "Administrator, buyer and approver",
      "start": "Start: confirm a vendor, item and receiving warehouse before ordering.",
      "end": "End: a numbered PO is approved by a different authorized person and ready for receipt.",
      "segments": [
        "vendor_setup",
        "item_setup",
        "location_check",
        "po_create",
        "po_submit",
        "po_approval"
      ]
    },
    {
      "id": "goods_receipt",
      "title": "Goods receipt — repeat setup, then receive against PO",
      "actor": "Administrator, buyer, approver and receiver",
      "start": "Start: reconfirm the vendor, item, warehouse and approved PO; do not receive against an unrelated order.",
      "end": "End: a numbered GRN is posted and the item/location stock view is checked.",
      "segments": [
        "vendor_setup",
        "item_setup",
        "location_check",
        "po_create",
        "po_submit",
        "po_approval",
        "grn_post"
      ]
    },
    {
      "id": "users_and_roles",
      "title": "Users and roles - a person who sees only their module",
      "actor": "Administrator",
      "start": "Start: decide what this person should be able to see, before creating their account.",
      "end": "End: an Active user whose role sees only the granted module; at first sign-in they set their own password.",
      "segments": [
        "role_setup",
        "user_setup"
      ]
    },
    {
      "id": "bin_setup",
      "title": "Bins and zones - set up a storage position",
      "actor": "Administrator",
      "start": "Start: confirm the warehouse the bin belongs to.",
      "end": "End: a saved bin in a named zone at that warehouse; the zone was created without leaving the form.",
      "segments": [
        "location_check",
        "bin_zone_setup"
      ]
    },
    {
      "id": "request_for_quotation",
      "title": "Request for quotation - from vendor to chosen price",
      "actor": "Administrator and buyer",
      "start": "Start: the supplier you will invite must exist as a vendor.",
      "end": "End: a Closed RFQ with one selected quote; the buyer raises the purchase order next.",
      "segments": [
        "vendor_setup",
        "rfq_quotes"
      ]
    },
    {
      "id": "stock_transfer",
      "title": "Stock transfer - warehouse to shop",
      "actor": "Administrator and stock controller",
      "start": "Start: confirm the sending warehouse holds the stock you will move.",
      "end": "End: a Received transfer and the shop's stock row showing the units that arrived.",
      "segments": [
        "location_check",
        "transfer_stock"
      ]
    },
    {
      "id": "pos_shift",
      "title": "Point of sale - one cashier shift",
      "actor": "Cashier",
      "start": "Start: the shop is a selling location with stock, and the cashier's account is assigned to it.",
      "end": "End: a completed cash sale and a closed session whose counted cash matches the expected amount.",
      "segments": [
        "pos_open_till",
        "pos_sale",
        "pos_close_till"
      ]
    },
    {
      "id": "supplier_bill",
      "title": "Supplier bill - from order and receipt to a paid, matched invoice",
      "actor": "Buyer, approver, receiver and accounts",
      "start": "Start: reconfirm the vendor, item and warehouse, raise and approve the PO, receive the goods - the bill is checked against both.",
      "end": "End: the bill is Matched against the PO and the accepted goods, then Paid; its GST sits in GST Input Credit.",
      "segments": [
        "vendor_setup",
        "item_setup",
        "location_check",
        "po_create",
        "po_submit",
        "po_approval",
        "grn_post",
        "supplier_invoice"
      ]
    },
    {
      "id": "online_order",
      "title": "Online order - from phone order to paid invoice",
      "actor": "Order desk, warehouse and accounts",
      "start": "Start: the item has stock at a warehouse; a customer places an order by phone.",
      "end": "End: the order is Shipped, its stock and cost are posted, and its invoice is posted and settled.",
      "segments": [
        "oms_manual_order",
        "oms_release",
        "fulfillment_dispatch",
        "sales_invoice_post"
      ]
    },
    {
      "id": "journal_voucher",
      "title": "Journal voucher - a month-end accrual, raised and approved",
      "actor": "Accountant and controller",
      "start": "Start: a cost is owed this month but will be paid next month (October salaries).",
      "end": "End: a balanced voucher, approved by a second person, posted to Salary Expense and Salary Payable.",
      "segments": [
        "jv_create",
        "jv_approve"
      ]
    },
    {
      "id": "debit_credit_notes",
      "title": "Debit and credit notes - adjusting what suppliers and customers owe",
      "actor": "Buyer, approver and accounts",
      "start": "Start: a supplier agreed a rebate on an approved order; a customer was overcharged.",
      "end": "End: a posted debit note against the supplier's order and a posted credit note refunding the customer.",
      "segments": [
        "vendor_setup",
        "item_setup",
        "location_check",
        "po_create",
        "po_submit",
        "po_approval",
        "debit_note",
        "customer_setup",
        "credit_note"
      ]
    },
    {
      "id": "location_movement_chapter",
      "title": "Location movement - re-slot stock between bins in one warehouse",
      "actor": "Warehouse administrator and warehouse staff",
      "start": "Start: the warehouse has stock received; two bins exist in one zone.",
      "end": "End: part of a bin's stock moved to another bin at the same warehouse, recorded on the stock ledger.",
      "segments": [
        "location_check",
        "bin_zone_setup",
        "bin_second_setup",
        "putaway_stock",
        "location_movement"
      ]
    },
    {
      "id": "offers_and_coupons",
      "title": "Offers - a coupon discount on a group of products",
      "actor": "Merchandiser and cashier",
      "start": "Start: a promotion covers a chosen set of products and is redeemed with a coupon.",
      "end": "End: the offer is live, and a till sale applies it only when the coupon is entered.",
      "segments": [
        "product_group_setup",
        "offer_setup",
        "pos_open_till",
        "pos_sale_coupon",
        "pos_close_till"
      ]
    },
    {
      "id": "purchase_return_chapter",
      "title": "Purchase return - send goods back against their GRN",
      "actor": "Buyer, approver and receiver",
      "start": "Start: goods arrived on a receipt against an approved PO, and some must go back.",
      "end": "End: the returned units have left stock and a posted debit note records what the supplier owes.",
      "segments": [
        "vendor_setup",
        "item_setup",
        "location_check",
        "po_create",
        "po_submit",
        "po_approval",
        "grn_post",
        "purchase_return"
      ]
    },
    {
      "id": "hr_month",
      "title": "HR - from a new employee to a posted payslip",
      "actor": "HR, manager and accounts",
      "start": "Start: a new store associate joins on 1 October.",
      "end": "End: their leave approved, attendance marked, and October payroll run and posted to the accounts.",
      "segments": [
        "employee_setup",
        "salary_structure_setup",
        "leave_request",
        "attendance_mark",
        "payroll_run"
      ]
