# Custom ERP production/staging environment file.
#
# Copy to /etc/erp/erp.env on the Droplet, fill in real values, then:
#   sudo chown root:erp /etc/erp/erp.env && sudo chmod 640 /etc/erp/erp.env
# systemd loads this via EnvironmentFile= (see deploy/erp.service). This is the
# Linux equivalent of manage.ps1 setting $env:PORT / $env:DATABASE_URL on Windows.
#
# Lines are KEY=VALUE (no `export`, no quotes needed by systemd). Never commit a
# filled-in copy of this file.

# --- Required -------------------------------------------------------------

# Self-hosted Postgres on this same box (loopback, so sslmode=disable is fine -
# traffic never leaves the machine). Replace the password with the strong one
# you set when creating the `erp` role. DB name matches the dev default.
DATABASE_URL=postgres://erp:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/custom_erp?sslmode=disable

# HTTP port the Go server listens on (Caddy reverse-proxies to this on 80/443).
PORT=8080

# Bind the Go server to loopback only (Stage 28.4) so nothing reaches it
# directly from the public internet -- every request must come through Caddy,
# which connects on localhost:8080 (see deploy/Caddyfile). Leave HOST unset only
# if you deliberately want the Go port exposed (then a firewall must guard it).
HOST=127.0.0.1

# Trust the reverse proxy's X-Forwarded-For for the real client IP (Stage 28.4).
# REQUIRED behind Caddy: without it, per-IP rate limiting sees only Caddy's
# loopback address and lumps every client into one shared bucket (one noisy
# client throttles everyone, and per-IP login throttling is defeated). Only set
# this when a trusted proxy is genuinely in front -- a direct client could
# otherwise forge X-Forwarded-For to dodge rate limits.
TRUST_PROXY=1

# HMAC signing key for auth tokens. MUST be set explicitly in production:
# if unset, engines/auth.go generates a local key file and every redeploy that
# loses it logs all users out. Generate once with:  openssl rand -hex 48
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48

# --- Flip to production once a real admin exists (see runbook Part D) --------
# Leave this UNSET for the very first bring-up so the seed admin still works and
# you can log in. After creating a real admin + disabling the seed one, set:
#   ENV=production
# which (a) hard-stops startup if the seed admin credential is still active
# (routes.go:40) and (b) disables the /api/v1/debug/panic test route.
#ENV=production

# --- Recommended ----------------------------------------------------------

# Restrict browser CORS to your real origin(s), comma-separated. Until your
# domain is live you can leave this unset (defaults allow localhost only).
#CORS_ALLOWED_ORIGINS=https://erp.yourdomain.com

# Ops alerting webhook (go_live_decisions.md section 2). Slack/Teams-compatible
# incoming webhook; panic/failed-backup/error-rate alerts POST here. No-ops if unset.
#OPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Encryption key for the nightly backup script (deploy/backup.sh). Generate once
# with:  openssl rand -hex 32   -- back this up SEPARATELY from the box; losing it
# makes existing encrypted backups unrecoverable.
#BACKUP_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Optional (only if you use these features) ----------------------------

# Auth token lifetime in hours (engines/auth.go, defaults to a built-in value).
#JWT_EXPIRY_HOURS=12

# Encryption key for stored sales-channel credentials (engines/channel_credentials.go).
# Set before saving any Shopify/BigCommerce/Magento connector credentials.
# MUST be exactly 32 bytes (AES-256) or the server refuses to start -- generate a
# 32-CHARACTER value with:  openssl rand -hex 16   (hex 16 = 32 chars, NOT hex 32).
#CHANNEL_CREDENTIAL_KEY=CHANGE_ME_openssl_rand_hex_16_gives_32_chars

# Shopify webhook HMAC secret (engines connector), if you wire up Shopify.
#SHOPIFY_WEBHOOK_SECRET=

# SMTP for password-reset emails (engines/password_reset.go). Without these the
# forgot-password flow can't actually send mail.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_FROM=no-reply@yourdomain.com
#SMTP_USER=
#SMTP_PASSWORD=
