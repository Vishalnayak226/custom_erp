# including a committed .map that defeated the point of shipping a minified bundle.
public/dist/

# Runtime logs (manage.ps1)
logs/

# Database backup artifacts (manage.ps1 backup)
backups/

# Local credentials - never commit
*.local.txt
DEV_CREDENTIALS.local.txt
*.local.json
CONNECTOR_CREDENTIALS.local.json
*.local.md
# End-user launcher: hardcodes the staging host and opens a root SSH tunnel to
# it, the same details STAGING_ACCESS.local.md is kept out of the repo for.
Open-ERP.cmd

# Editor configs
.claude/
CLAUDE.md
graphify-out/

# task-observer skill scratch (agent-local, same rationale as .claude/).
# Its log uses strict sequential numbering and warns about parallel-session
# collisions - exactly the wrong shape for a tree that sees concurrent edits.
skill-observations/

# deploy.ps1 cross-compiles the Linux binary here before scp'ing it (~11MB).
# Build output, never source.
deploy/build/

# SOP video recordings (~500 MB) - rebuilt from the tracked scripts and tools
# in docs/sop-video, shared with clients outside git (checklist 57.12a).
docs/sop-video/media/
docs/sop-video/output/

# Local exports of the trackers (e.g. a printable micro_checklist.pdf) -
# working copies, never source; the Markdown is the record.
docs/micro_checklist.pdf

# Stage 109: release coordination and reports stay on this machine
release/hold.txt
release/reports/
